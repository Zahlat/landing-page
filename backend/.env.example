# Copy to backend/.env and fill in. Never commit the real .env.
# Generate each secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# dev | test | prod  (prod turns off /docs and /openapi.json, and is the default if unset)
ENVIRONMENT=dev

DATABASE_URL=postgresql+asyncpg://meraki:CHANGE_ME@localhost:5432/meraki
# Used only by pytest. Must be a different database whose name ends in _test.
TEST_DATABASE_URL=postgresql+asyncpg://meraki:CHANGE_ME@localhost:5432/meraki_test

# Shared secret Next.js sends as X-Internal-Token. Must equal BACKEND_INTERNAL_TOKEN in Next. Min 32 chars.
INTERNAL_TOKEN=CHANGE_ME_random_32_bytes_urlsafe_token
# HMAC key for client IPs. Changing it resets rate-limit history. Min 32 chars.
IP_HASH_SECRET=CHANGE_ME_random_32_bytes_urlsafe_token

RATE_LIMIT_IP_PER_HOUR=5
RATE_LIMIT_EMAIL_PER_HOUR=3
# More URLs than this in one message is rejected (422 too_many_links).
MAX_LINKS_PER_MESSAGE=3
# Same email + content within this window is silently dropped (fake 202).
DUPLICATE_WINDOW_HOURS=24
ADMIN_SESSION_HOURS=8
# Account lockout: N consecutive failed logins -> locked for M minutes.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Per-IP login limit: at most N attempts per M minutes.
LOGIN_IP_MAX_ATTEMPTS=10
LOGIN_IP_WINDOW_MINUTES=15
