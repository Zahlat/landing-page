# Copy to deploy/.env on the server and fill in. Never commit the real file.
# Generate each secret with:  openssl rand -hex 32
# (Hex is URL-safe, which matters because the database password goes inside a URL.)

# --- What runs ------------------------------------------------------------------------
# db      = Postgres in a container. Remove it to use a managed database (see DATABASE_URL).
# tunnel  = Cloudflare Tunnel: no open ports on the server. Needs TUNNEL_TOKEN.
# caddy   = automatic HTTPS on ports 80/443 of a normal VPS. Needs SITE_ADDRESS.
# Choose tunnel OR caddy, not both.
COMPOSE_PROFILES=db,tunnel

# --- Public address -------------------------------------------------------------------
# Built into the site for canonical URLs and the sitemap. Rebuild if it changes.
SITE_URL=https://example.com

# The header that holds the real visitor IP. It must be one your edge always overwrites.
#   tunnel -> cf-connecting-ip
#   caddy  -> x-real-ip
TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip

TUNNEL_TOKEN=
# Caddy only: your domain, for example example.com
SITE_ADDRESS=

# --- Secrets (required) ---------------------------------------------------------------
# Shared between Next.js and FastAPI.
INTERNAL_TOKEN=
FORM_SIGNING_SECRET=
# Changing this resets rate-limit history.
IP_HASH_SECRET=

# Database administrator; only used for setup and backups.
POSTGRES_PASSWORD=
# The restricted account the app uses.
APP_DB_PASSWORD=

# Managed database instead of the db profile. Leave empty to use the container.
# Example: postgresql+asyncpg://user:password@host:5432/meraki
DATABASE_URL=

# --- Scaling --------------------------------------------------------------------------
# Web and API hold no state, so you can raise these on a larger server.
WEB_REPLICAS=1
API_REPLICAS=1

# --- Images ---------------------------------------------------------------------------
# Leave as-is to build on the server. To pull from a registry instead, for example:
#   WEB_IMAGE=ghcr.io/your-user/meraki-web:COMMIT_SHA
WEB_IMAGE=meraki-web:local
API_IMAGE=meraki-api:local

# --- Optional -------------------------------------------------------------------------
BACKUP_KEEP_DAYS=14
# Overrides the WhatsApp number built into the site.
WHATSAPP_NUMBER=
