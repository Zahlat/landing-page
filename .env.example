# Public company WhatsApp number (Syria): domestic 0991953560, international +963991953560.
# The code already uses this number as a fallback; override only when it changes.
WHATSAPP_NUMBER=963991953560

# Set after purchasing a domain. Enables absolute canonical URLs and hreflang metadata.
NEXT_PUBLIC_SITE_URL=

# Copy the rest to .env.local. None of these may ever get a NEXT_PUBLIC_ prefix.
# Private FastAPI address; never exposed to the browser.
BACKEND_URL=http://127.0.0.1:8000
# Must equal INTERNAL_TOKEN in backend/.env.
BACKEND_INTERNAL_TOKEN=CHANGE_ME_random_32_bytes_urlsafe_token
# Signs the contact form's fill-time timestamp.
FORM_SIGNING_SECRET=CHANGE_ME_random_32_bytes_urlsafe_token
# Header your host overwrites with the real visitor IP, e.g. cf-connecting-ip or x-real-ip.
# Leave empty only in local dev: when empty, all visitors share one rate-limit bucket.
TRUSTED_CLIENT_IP_HEADER=
